+namespace {
+IMedia::MetadataType trackSelectionType( IFile::Type type )
+{
+    return type == IFile::Type::Subtitles ? IMedia::MetadataType::SubtitleFileSelection
+                                         : IMedia::MetadataType::SoundtrackFileSelection;
+}
+}
+
+bool getTrackSelection( const IMedia& media, IFile::Type type, std::vector<std::string>& mrls )
+{
+    mrls.clear();
+    if ( type != IFile::Type::Subtitles && type != IFile::Type::Soundtrack )
+        return false;
+    const auto& value = media.metadata( trackSelectionType( type ) );
+    if ( value.isSet() == false )
+        return false;
+    const auto& text = value.asStr();
+    if ( text.compare( 0, 2, "1|" ) != 0 )
+        return false;
+    std::vector<std::string> parsed;
+    size_t offset = 2;
+    try
+    {
+        while ( offset < text.size() )
+        {
+            const auto end = text.find( ':', offset );
+            if ( end == std::string::npos || end == offset )
+                return false;
+            for ( size_t i = offset; i < end; ++i )
+                if ( text[i] < '0' || text[i] > '9' )
+                    return false;
+            const auto length = std::stoull( text.substr( offset, end - offset ) );
+            if ( length == 0 || length > text.size() - end - 1 )
+                return false;
+            parsed.emplace_back( text.substr( end + 1, static_cast<size_t>( length ) ) );
+            offset = end + 1 + static_cast<size_t>( length );
+        }
+    }
+    catch ( const std::exception& )
+    {
+        return false;
+    }
+    mrls = std::move( parsed );
+    return true;
+}
+
