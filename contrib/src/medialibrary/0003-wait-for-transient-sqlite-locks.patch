Subject: [PATCH] sqlite: wait briefly for external database locks

A read transaction from another SQLite connection can prevent BEGIN
EXCLUSIVE. With no busy handler, the background parser throws DatabaseBusy
for even a momentary conflict. Install a five-second busy timeout on every
connection before its first pragma or query, and avoid restarting that
timeout in the statement retry loop after SQLite reports SQLITE_BUSY.

A regression holds a separate read snapshot, verifies successful writes
after a short lock, verifies that sustained contention times out, and checks
that the connection can write again after the reader releases its lock.

---
--- a/src/database/SqliteConnection.cpp
+++ b/src/database/SqliteConnection.cpp
@@ -109,6 +109,12 @@
     res = sqlite3_extended_result_codes( dbConnection, 1 );
     if ( res != SQLITE_OK )
         errors::mapToException( "<enabling extended errors>", "", res );
+    // External SQLite readers can briefly prevent an exclusive transaction.
+    // Wait for those locks rather than immediately aborting background work.
+    // Keep the wait bounded so an abandoned transaction cannot block forever.
+    res = sqlite3_busy_timeout( dbConnection, 5000 );
+    if ( res != SQLITE_OK )
+        errors::mapToException( "<setting busy timeout>", "", res );
     // Don't use public wrapper, they need to be able to call getConn, which
     // would result from a recursive call and a deadlock from here.
     setPragma( dbConnection, "foreign_keys", "1" );
--- a/src/database/SqliteTools.cpp
+++ b/src/database/SqliteTools.cpp
@@ -187,7 +187,10 @@
             return Row( m_stmt.get() );
         else if ( res == SQLITE_DONE )
             return Row{};
-        else if ( ( Transaction::isInProgress() == false ||
+        // The busy handler has already waited. Retrying SQLITE_BUSY here
+        // would restart that timeout and multiply the maximum lock wait.
+        else if ( res != SQLITE_BUSY &&
+                  ( Transaction::isInProgress() == false ||
                     m_isCommit == true ) &&
                   errors::isInnocuous( res ) && maxRetries-- > 0 )
             continue;
--- /dev/null
+++ b/test/unittest/SqliteBusyTests.cpp
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#if HAVE_CONFIG_H
+#include "config.h"
+#endif
+#include "database/SqliteConnection.h"
+#include "logging/Logger.h"
+#include "logging/IostreamLogger.h"
+#include "database/SqliteTransaction.h"
+#include "database/SqliteErrors.h"
+#include <sqlite3.h>
+#include <chrono>
+#include <cstdio>
+#include <future>
+#include <iostream>
+#include <memory>
+#include <thread>
+#ifdef _WIN32
+#include <process.h>
+#else
+#include <unistd.h>
+#endif
+using namespace medialibrary;
+using Clock = std::chrono::steady_clock;
+static void execute(sqlite3* db, const char* sql)
+{
+    if (sqlite3_exec(db, sql, nullptr, nullptr, nullptr) != SQLITE_OK)
+        throw std::runtime_error(sqlite3_errmsg(db));
+}
+static bool contention(const std::shared_ptr<sqlite::Connection>& connection,
+                       const std::string& path, bool holdToTimeout)
+{
+    std::promise<void> prepared, start;
+    auto preparedFuture = prepared.get_future();
+    auto startFuture = start.get_future();
+    auto worker = std::async(std::launch::async, [&] {
+        { auto initialize = connection->acquireReadContext(); }
+        prepared.set_value();
+        startFuture.wait();
+        const auto begin = Clock::now();
+        bool busy = false;
+        try {
+            auto transaction = connection->newTransaction();
+            execute(sqlite::Connection::Context::handle(), "INSERT INTO BusyCheck VALUES(2)");
+            transaction->commit();
+        } catch (const sqlite::errors::DatabaseBusy&) { busy = true; }
+        const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now()-begin).count();
+        return std::make_pair(busy, elapsed);
+    });
+    preparedFuture.wait();
+    sqlite3* handle = nullptr;
+    if (sqlite3_open_v2(path.c_str(), &handle, SQLITE_OPEN_READONLY, nullptr) != SQLITE_OK)
+        throw std::runtime_error("Reader did not open");
+    std::unique_ptr<sqlite3,decltype(&sqlite3_close)> reader(handle,sqlite3_close);
+    execute(reader.get(), "BEGIN; SELECT * FROM BusyCheck");
+    start.set_value();
+    if (!holdToTimeout) std::this_thread::sleep_for(std::chrono::milliseconds(200));
+    else if (worker.wait_for(std::chrono::seconds(7)) != std::future_status::ready) {
+        execute(reader.get(), "COMMIT");
+        worker.wait();
+        std::cerr << "Busy wait did not finish within its bound\n";
+        return false;
+    }
+    execute(reader.get(), "COMMIT");
+    const auto result = worker.get();
+    std::cout << (holdToTimeout ? "persistent" : "transient") << ": busy=" << result.first
+              << ", elapsed=" << result.second << "ms\n";
+    return holdToTimeout ? result.first && result.second >= 4500 && result.second < 7000
+                         : !result.first && result.second >= 150 && result.second < 2000;
+}
+int main(int argc, char** argv)
+{
+    if (argc != 2) return 2;
+    Log::SetLogger(std::make_shared<IostreamLogger>());
+    Log::setLogLevel(LogLevel::Error);
+#ifdef _WIN32
+    const auto pid = _getpid();
+#else
+    const auto pid = getpid();
+#endif
+    const auto path = std::string(argv[1])+"-"+std::to_string(pid)+".db";
+    struct Cleanup { std::string path; ~Cleanup() { std::remove(path.c_str()); } } cleanup{path};
+    try {
+        auto connection = sqlite::Connection::connect(path);
+        { auto context = connection->acquireWriteContext();
+          execute(context.handle(), "CREATE TABLE BusyCheck(value INTEGER); INSERT INTO BusyCheck VALUES(1)"); }
+        if (!contention(connection,path,false) || !contention(connection,path,true)) return 1;
+        auto transaction = connection->newTransaction();
+        execute(sqlite::Connection::Context::handle(), "INSERT INTO BusyCheck VALUES(3)");
+        transaction->commit();
+        return 0;
+    } catch (const std::exception& error) { std::cerr << error.what() << '\n'; return 1; }
+}
--- a/meson.build
+++ b/meson.build
@@ -178,6 +178,21 @@
 # Ideally we shouldn't need an option to build tests, but we need
 # https://github.com/mesonbuild/meson/issues/2518
 # to be fixed first
+# SQLite connection tests do not need a libvlc parser backend.
+if not get_option('tests').disabled()
+  sqlite_busy_test = executable('sqlite_busy_tests', 'test/unittest/SqliteBusyTests.cpp',
+    link_with: [medialib],
+    include_directories: includes,
+    dependencies: [sqlite_dep, threads_dep],
+    build_by_default: false,
+  )
+  test('Sqlite.BusyTimeout', sqlite_busy_test,
+    args: [meson.current_build_dir() / 'sqlite-contention'],
+    timeout: 15,
+    suite: ['unittest', 'Sqlite'],
+  )
+endif
+
 if libvlc_dep.found() and not get_option('tests').disabled()
   subdir('test')
 endif
